# Copiar este archivo a .env.local y llenar con tus valores reales
# NUNCA subir .env.local a GitHub

# Gemini API key (opcional - si no está, usa las keys internas de gemini-keys.js)
# GEMINI_API_KEY=tu_api_key_gemini_aqui

# Meta WhatsApp API Token (para webhook de WhatsApp)
# WHATSAPP_API_TOKEN=tu_token_meta_aqui

# Firebase config (si lo necesitas en el futuro)
# FIREBASE_API_KEY=...
# FIREBASE_AUTH_DOMAIN=...
