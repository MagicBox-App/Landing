rules_version = '2';

// Publicar en: Firebase Console → Firestore Database → Reglas.
// Todo lo demas queda denegado por default (comportamiento estandar
// de Firestore cuando una ruta no matchea ninguna regla explicita).
service cloud.firestore {
  match /databases/{database}/documents {

    match /catalog_categories/{categoryId} {
      allow read, write: if request.auth != null;
    }

    match /catalog_items/{itemId} {
      allow read, write: if request.auth != null;
    }

    match /state/{docId} {
      allow read, write: if request.auth != null;
    }

    match /order_history/{orderId} {
      allow read, write: if request.auth != null;
    }
  }
}
